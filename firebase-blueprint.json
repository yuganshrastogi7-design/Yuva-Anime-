{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific data and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "WatchlistItem": {
      "title": "Watchlist Item",
      "description": "An anime added to the user's watchlist",
      "type": "object",
      "properties": {
        "animeId": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["PLANNING", "WATCHING", "COMPLETED", "DROPPED"] },
        "watchedEpisodes": { "type": "array", "items": { "type": "number" } },
        "lastEpisode": { "type": "number" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["animeId", "title"]
    },
    "HistoryItem": {
      "title": "Watch History",
      "description": "Watch history for a specific anime",
      "type": "object",
      "properties": {
        "animeId": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "lastEpisode": { "type": "number" },
        "watchedEpisodes": { "type": "array", "items": { "type": "number" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["animeId"]
    },
    "CommunityPost": {
      "title": "Community Discussion Post",
      "description": "User-generated discussion topic and chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "votes": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/watchlist/{animeId}": {
      "schema": "WatchlistItem",
      "description": "User watchlists"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "User watch history"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "User community discussions"
    }
  }
}
