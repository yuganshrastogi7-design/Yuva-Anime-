rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'createdAt']) &&
               data.uid == userId &&
               data.uid == request.auth.uid &&
               data.createdAt == request.time &&
               data.displayName is string &&
               data.displayName.size() <= 100;
      }

      // --- Watchlist ---
      match /watchlist/{animeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(animeId);
        allow create: if isOwner(userId) && isValidId(animeId) && isValidWatchlistItem(incoming());
        allow update: if isOwner(userId) && isValidId(animeId) && isValidWatchlistItem(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasAny(['status', 'updatedAt', 'watchedEpisodes', 'lastEpisode']) &&
                      incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) && isValidId(animeId);

        function isValidWatchlistItem(data) {
          return data.keys().hasAll(['animeId', 'title', 'addedAt', 'status']) &&
                 data.animeId == animeId &&
                 data.title is string &&
                 data.title.size() <= 500 &&
                 data.addedAt == (request.method == 'create' ? request.time : existing().addedAt) &&
                 data.status in ['PLANNING', 'WATCHING', 'COMPLETED', 'DROPPED'] &&
                 (data.get('watchedEpisodes', []) is list) &&
                 (data.get('lastEpisode', 0) is number);
        }
      }

      // --- History ---
      match /history/{animeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(animeId);
        allow create: if isOwner(userId) && isValidId(animeId) && isValidHistoryItem(incoming());
        allow update: if isOwner(userId) && isValidId(animeId) && isValidHistoryItem(incoming()) &&
                      incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) && isValidId(animeId);

        function isValidHistoryItem(data) {
          return data.keys().hasAll(['animeId', 'updatedAt']) &&
                 data.animeId == animeId &&
                 data.updatedAt == request.time &&
                 (data.get('watchedEpisodes', []) is list) &&
                 (data.get('lastEpisode', 0) is number);
        }
      }
    }

    // --- Real User Community Discussions & Live Chat ---
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
